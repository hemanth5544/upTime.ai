# Optional: a GitHub personal access token raises the REST rate limit from 60 to
# 5000 requests/hour. Copy this file to .env.local and fill it in.
#
# Vite inlines VITE_* values into the JavaScript bundle, so anyone who can open the
# built site can read this token. Use a fine-grained token with "Public repositories
# (read-only)" access and no extra permissions, and leave it empty for public deploys.
VITE_GITHUB_TOKEN=
